NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173

# Production only: share the session cookie between app. and api. subdomains
# COOKIE_DOMAIN=.yourdomain.com
# Number of reverse proxies in front of the API (1 on Railway/Render), so
# request IPs are logged correctly
# TRUST_PROXY=1

# Neon: DATABASE_URL is the pooled string (host contains "-pooler"), used by
# the app. DATABASE_URL_UNPOOLED is the direct string, used by Prisma migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Local Postgres (docker-compose.yml). Leave DATABASE_URL_UNPOOLED unset.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public
